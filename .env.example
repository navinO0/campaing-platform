# Application
NEXT_PUBLIC_APP_NAME="WhatsApp Campaign Manager"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"

# PostgreSQL Database (Dedicated Schema: whatsapp_campaign)
DATABASE_URL="postgres://postgres:password@your-postgres-host:5432/postgres?sslmode=require"

# n8n Orchestrator (Server-side ONLY - Never expose via NEXT_PUBLIC_)
N8N_BASE_URL="https://n8n.your-domain.com"
N8N_API_KEY="your_n8n_api_key_here"
N8N_WEBHOOK_SECRET="your_webhook_hmac_secret_key"

# n8n Webhook Paths
N8N_CONTACTS_WEBHOOK="/webhook/whatsapp-campaign/contacts"
N8N_TEMPLATES_WEBHOOK="/webhook/whatsapp-campaign/templates"
N8N_CAMPAIGNS_WEBHOOK="/webhook/whatsapp-campaign/campaigns"
N8N_CAMPAIGN_START_WEBHOOK="/webhook/whatsapp-campaign/start"
N8N_CAMPAIGN_STOP_WEBHOOK="/webhook/whatsapp-campaign/stop"
N8N_CAMPAIGN_STATUS_WEBHOOK="/webhook/whatsapp-campaign/status"
N8N_CAMPAIGN_LOGS_WEBHOOK="/webhook/whatsapp-campaign/logs"
N8N_CUSTOMER_IMPORT_WEBHOOK="/webhook/whatsapp-campaign/import"
N8N_MEDIA_UPLOAD_WEBHOOK="/webhook/whatsapp-campaign/media"
N8N_TEMPLATE_PREVIEW_WEBHOOK="/webhook/whatsapp-campaign/preview"

# Polling and Resiliency
N8N_REQUEST_TIMEOUT_MS=15000
N8N_MAX_RETRIES=2
CAMPAIGN_STATUS_POLL_INTERVAL_MS=5000

# Evolution API Parameters (Orchestrated through n8n - Server-side reference)
EVOLUTION_API_URL="https://evo.your-domain.com"
EVOLUTION_INSTANCE_NAME="YourInstanceName"
EVOLUTION_API_KEY="your_evolution_api_key_here"

# Authentication (Optional / Auth.js)
AUTH_SECRET=""
